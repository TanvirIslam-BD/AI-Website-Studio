# ---------------------------------------------------------------------------
# Database: Turso (libSQL)
#
# Create one with the Turso CLI:
#   turso db create ai-website-studio
#   turso db show ai-website-studio --url          -> TURSO_DATABASE_URL
#   turso db tokens create ai-website-studio       -> TURSO_AUTH_TOKEN
#
# Leave TURSO_DATABASE_URL blank to develop against the local SQLite file in
# DATABASE_URL instead. Both go through the same libSQL driver adapter, so the
# code path is identical either way.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Local fallback, and the file the Prisma CLI uses when TURSO_DATABASE_URL is
# unset. Must be a file: URL, resolved relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth.js  (generate a secret: openssl rand -base64 32, or see README for PowerShell)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth providers. Each button is hidden unless both of its variables
# are set, so you can ship with one, both or neither.
#
#   GitHub: https://github.com/settings/developers -> New OAuth App
#     Authorization callback URL:
#       http://localhost:3000/api/auth/callback/github
#       https://<your-domain>/api/auth/callback/github
#
#   Google: https://console.cloud.google.com/apis/credentials
#     -> Create credentials -> OAuth client ID -> Web application
#     Authorised redirect URI:
#       http://localhost:3000/api/auth/callback/google
#       https://<your-domain>/api/auth/callback/google
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Owner console  (/admin)
#
# Comma-separated emails that may open the operator console: platform totals,
# the AI-versus-template switch, the pause levers and per-workspace plans.
#
# Deliberately an environment variable rather than a database flag - no request
# the app serves can write to it, so no bug in a signup or profile path can
# hand someone the console. Everyone else gets a 404, on the page and on its
# APIs, so the console is not discoverable by probing.
# ---------------------------------------------------------------------------
# Set it WITHOUT quotes in a hosting dashboard - the box stores exactly what is
# typed, and quotes copied from this file would become part of the address.
OWNER_EMAILS=""

# ---------------------------------------------------------------------------
# Plans and credits
#
# Limits live in src/lib/billing/plans.ts (Free: 1 website, no editing, no
# publishing; Pro and Agency: both, with a monthly credit allowance).
#
# BILLING_PROVIDER names the checkout to send upgrades to. Leave it blank and
# the upgrade button reports that checkout is not configured, while an operator
# can still grant a plan from /admin - which is what self-hosting wants.
# ---------------------------------------------------------------------------
BILLING_PROVIDER=""

# ---------------------------------------------------------------------------
# LLM provider. Set ONE of the key blocks below, or leave them all blank to run
# the deterministic offline template provider (the app stays fully usable
# without any AI credentials).
#
# AI_PROVIDER: comet | anthropic | openai | mock
#   Leave blank to auto-select whichever key is present (CometAPI first).
#   An explicit value is honoured exactly - if its key is missing the app falls
#   back to templates rather than spending another provider's credits.
# ---------------------------------------------------------------------------
AI_PROVIDER="comet"

# CometAPI - one OpenAI-compatible key fronting many upstream models.
#   Keys: https://api.cometapi.com  |  set COMETAPI_MODEL to any model in their
#   catalogue. Compare candidates against the real generation path first:
#     npm run try:model claude-haiku-4-5-20251001 gemini-3.8-flash
#   A model that answers a toy prompt well can still return a thin site here,
#   because anything failing the section schemas is dropped rather than raised.
COMETAPI_API_KEY=""
COMETAPI_MODEL="claude-haiku-4-5-20251001"
COMETAPI_BASE_URL="https://api.cometapi.com/v1"

# Anthropic direct
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# OpenAI direct (OPENAI_BASE_URL also works for any other compatible gateway)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_BASE_URL=""

# ---------------------------------------------------------------------------
# Credential encryption (required)
#
# Each workspace connects its own Vercel account, and that token is stored
# encrypted at rest with AES-256-GCM. Generate a 32-byte key:
#   openssl rand -base64 32
#   PowerShell: see README
# Changing this key makes existing stored connections unreadable - users would
# have to reconnect.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Connect with Vercel (recommended)
#
# Lets users connect their own Vercel account by clicking a button instead of
# pasting an access token. Register an integration once, as the operator:
#
#   1. https://vercel.com/dashboard/integrations/console  ->  Create
#   2. Redirect URL - ONE url only:
#        https://<your-domain>/api/integrations/vercel/callback
#      Localhost is allowed, so register a second integration for local work
#      with http://localhost:3000/api/integrations/vercel/callback
#   3. Configuration URL (the "Configure" button on an installed integration):
#        https://<your-domain>/integrations/vercel/configure
#   4. API Scopes: Deployments read+write, Projects read+write,
#      Domains read+write, User read, Team read
#   5. Copy the client id, client secret and the integration's URL slug
#
# Leave these empty and the deploy dialog falls back to asking for a token,
# which keeps self-hosting workable with no integration to register.
# ---------------------------------------------------------------------------
VERCEL_INTEGRATION_CLIENT_ID=""
VERCEL_INTEGRATION_CLIENT_SECRET=""
VERCEL_INTEGRATION_SLUG=""

# ---------------------------------------------------------------------------
# Vercel deployment (optional fallback)
#
# Users deploy to their OWN Vercel account, connected from the deploy dialog.
# These variables are only a fallback for self-hosting and local development,
# used when a workspace has not connected an account of its own.
#   token:  https://vercel.com/account/tokens  (needs account scope, not
#           project-scoped - a first deployment has to create the project)
#   teamId: only for team accounts
# ---------------------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# ---------------------------------------------------------------------------
# Image providers (optional). Without a key the asset library falls back to a
# curated static collection so the flow still works offline.
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=""
