# ---------------------------------------------------------------------------
# Database (PostgreSQL). Local docker one-liner:
#   docker run --name aiws-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_website_studio?schema=public"

# ---------------------------------------------------------------------------
# Auth.js  (generate a secret with: openssl rand -base64 32)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional OAuth provider (leave blank to hide the button)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# LLM providers. Set at least one, or leave both blank to run the deterministic
# offline "template" provider (the app stays fully usable without API keys).
# AI_PROVIDER: anthropic | openai | mock
# ---------------------------------------------------------------------------
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ---------------------------------------------------------------------------
# Vercel deployment API
#   token:  https://vercel.com/account/tokens
#   teamId: optional, only for team accounts (starts with "team_")
# ---------------------------------------------------------------------------
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# ---------------------------------------------------------------------------
# Image providers (optional). Without a key the asset library falls back to a
# curated static collection so the flow still works offline.
# ---------------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=""
